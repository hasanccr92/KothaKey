<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_setup"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Brand header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_band"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:paddingTop="28dp"
            android:paddingRight="20dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/brand_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title_en"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.02"
                    android:text="@string/setup_title"
                    android:textColor="@android:color/white"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/title_bn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/setup_title_bn"
                    android:textColor="@android:color/white"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="18dp"
            android:paddingRight="20dp"
            android:paddingBottom="28dp">

            <!-- Copy panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/setup_body_bn"
                    android:textColor="@color/setup_ink"
                    android:textSize="15sp" />

                <View
                    android:layout_width="36dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/setup_green" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/setup_body"
                    android:textColor="@color/setup_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/enable"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/btn_primary"
                android:fontFamily="sans-serif-medium"
                android:text="@string/setup_enable"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <Button
                android:id="@+id/choose"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_secondary"
                android:fontFamily="sans-serif-medium"
                android:text="@string/setup_switch"
                android:textAllCaps="false"
                android:textColor="@color/setup_teal"
                android:textSize="16sp" />

            <Button
                android:id="@+id/settings"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_secondary"
                android:fontFamily="sans-serif-medium"
                android:text="@string/setup_settings"
                android:textAllCaps="false"
                android:textColor="@color/setup_teal"
                android:textSize="16sp" />

            <Button
                android:id="@+id/bengali_guide"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_secondary"
                android:fontFamily="sans-serif-medium"
                android:text="@string/settings_bengali_guide"
                android:textAllCaps="false"
                android:textColor="@color/setup_teal"
                android:textSize="16sp" />

            <Button
                android:id="@+id/telegram"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_telegram"
                android:fontFamily="sans-serif-medium"
                android:text="@string/setup_telegram"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/about_developed"
                    android:textColor="@color/setup_ink"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/about_developed_bn"
                    android:textColor="@color/setup_green"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/linkedin"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_secondary"
                        android:text="@string/about_linkedin"
                        android:textAllCaps="false"
                        android:textColor="@color/setup_teal" />

                    <Button
                        android:id="@+id/github"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_secondary"
                        android:text="@string/about_github"
                        android:textAllCaps="false"
                        android:textColor="@color/setup_teal" />
                </LinearLayout>

                <View
                    android:layout_width="36dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="10dp"
                    android:background="@color/setup_green" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/about_thanks"
                    android:textColor="@color/setup_ink"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/thanks_orbit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/about_thanks_orbit"
                    android:textColor="@color/setup_teal"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/thanks_ask"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/about_thanks_ask"
                    android:textColor="@color/setup_teal"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/thanks_avro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/about_thanks_avro"
                    android:textColor="@color/setup_teal"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/thanks_doto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/about_thanks_doto"
                    android:textColor="@color/setup_teal"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/app_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/setup_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/setup_try_label"
                android:textColor="@color/setup_ink"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/try_it"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_try_field"
                android:gravity="top"
                android:hint="@string/setup_hint"
                android:inputType="textMultiLine"
                android:minLines="4"
                android:padding="14dp"
                android:textColor="@color/setup_ink"
                android:textColorHint="#8A9A9E"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
